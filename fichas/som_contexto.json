          "id": "kind",
          "label": { "en": "Kind", "pt": "Tipo" },
          "input": "select",
          "options": [
            { "id": "album", "en": "Album", "pt": "Disco" },
            { "id": "single", "en": "Single", "pt": "Single" },
            { "id": "ep", "en": "EP", "pt": "EP" },
            { "id": "demo", "en": "Demo", "pt": "Demo" },
            { "id": "live", "en": "Live", "pt": "Ao vivo" }
          ]
        }
      ]
    },
