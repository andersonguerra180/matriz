        { "id": "project", "label": { "en": "Title or project", "pt": "Título ou projeto" }, "input": "text" },
        { "id": "scene", "label": { "en": "Scene or moment", "pt": "Cena ou momento" }, "input": "text" },
        { "id": "composer", "label": { "en": "Composer", "pt": "Compositor(a)" }, "input": "text" }
