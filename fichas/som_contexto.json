      "id": "music_production",
      "label": { "en": "Music Production", "pt": "Produção musical" },
      "fields": [
        { "id": "artist", "label": { "en": "Artist or band", "pt": "Artista ou banda" }, "input": "text" },
        { "id": "project", "label": { "en": "Project or song name", "pt": "Nome do projeto ou música" }, "input": "text" },
        {
          "id": "release_type",
