        { "id": "place", "label": { "en": "Place", "pt": "Local" }, "input": "text" },
        { "id": "date_time", "label": { "en": "Date and time", "pt": "Data e hora" }, "input": "text" },
        { "id": "what_recorded", "label": { "en": "What was recorded", "pt": "O que foi gravado" }, "input": "text" },
        { "id": "gear", "label": { "en": "Gear used", "pt": "Equipamento usado" }, "input": "text", "optional": true },
        { "id": "log_notes", "label": { "en": "Log Notes", "pt": "Notas de registro" }, "input": "longtext", "optional": true }
      ]
