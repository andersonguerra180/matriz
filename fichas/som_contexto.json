          "input": "select",
          "options": [
            { "id": "single", "en": "Single", "pt": "Single" },
            { "id": "ep", "en": "EP", "pt": "EP" },
            { "id": "album", "en": "Album", "pt": "Álbum" },
            { "id": "demo", "en": "Demo", "pt": "Demo" },
            { "id": "live", "en": "Live", "pt": "Ao vivo" }
          ]
        },
        {
          "id": "stage",
          "label": { "en": "Stage", "pt": "Etapa" },
          "input": "select",
          "options": [
            { "id": "recording", "en": "Recording", "pt": "Gravação" },
            { "id": "mixing", "en": "Mixing", "pt": "Mixagem" },
            { "id": "mastering", "en": "Mastering", "pt": "Masterização" },
            { "id": "final", "en": "Final", "pt": "Final" }
          ]
        },
        {
          "id": "recording_medium",
          "label": { "en": "Recording medium", "pt": "Mídia de gravação" },
          "input": "select",
          "options": [
            { "id": "daw", "en": "DAW", "pt": "DAW" },
            { "id": "tape_quarter", "en": "1/4\" Tape", "pt": "Fita 1/4\"" },
            { "id": "tape_half", "en": "1/2\" Tape", "pt": "Fita 1/2\"" },
            { "id": "tape_1in", "en": "1\" Tape", "pt": "Fita 1\"" },
            { "id": "tape_2in", "en": "2\" Tape", "pt": "Fita 2\"" },
            { "id": "cassette", "en": "Cassette Tape", "pt": "Fita Cassete" },
            { "id": "dat", "en": "DAT", "pt": "DAT (Fita de Áudio Digital)" },
            { "id": "adat", "en": "ADAT", "pt": "ADAT" },
            { "id": "dtrs", "en": "DTRS / Hi8 Digital Audio Tape", "pt": "Fita DTRS / Hi8 Digital Audio" },
            { "id": "minidisc", "en": "MiniDisc (MD)", "pt": "MiniDisc (MD)" },
            { "id": "audio_cd", "en": "Audio CD / CD-R", "pt": "CD de Áudio / CD-R" }
          ]
        },
        { "id": "description", "label": { "en": "Description", "pt": "Descrição" }, "input": "longtext", "optional": true }
      ]
    }
