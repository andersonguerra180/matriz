      "label": { "en": "Voice memo", "pt": "Nota de voz" },
      "fields": [
        { "id": "subject", "label": { "en": "Subject", "pt": "Assunto" }, "input": "text" },
        { "id": "date_place", "label": { "en": "Date and place", "pt": "Data e local" }, "input": "text", "optional": true }
      ]
    },
    {
      "id": "voice_over",
      "label": { "en": "Voice over", "pt": "Locução" },
      "fields": [
        { "id": "project", "label": { "en": "Project", "pt": "Projeto" }, "input": "text" },
        { "id": "voice_talent", "label": { "en": "Voice talent", "pt": "Locutor(a)" }, "input": "text" },
        { "id": "language", "label": { "en": "Language", "pt": "Idioma" }, "input": "text" },
        {
          "id": "version",
          "label": { "en": "Version", "pt": "Versão" },
          "input": "select",
          "options": [
            { "id": "draft", "en": "Draft", "pt": "Rascunho" },
            { "id": "final", "en": "Final", "pt": "Final" }
          ]
        },
        { "id": "recording_location", "label": { "en": "Recording location", "pt": "Local da gravação" }, "input": "text" }
      ]
    },
    {
      "id": "audiobook",
      "label": { "en": "Audiobook", "pt": "Audiolivro" },
