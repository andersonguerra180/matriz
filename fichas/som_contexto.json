          "id": "condition",
          "label": { "en": "Disc condition", "pt": "Estado do CD" },
          "input": "select",
          "options": [
            { "id": "good", "en": "Good", "pt": "Bom" },
            { "id": "scratched", "en": "Scratched", "pt": "Riscado" }
