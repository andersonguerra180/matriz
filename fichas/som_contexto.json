    "sourceMedia": {
      "id": "source_media",
      "label": { "en": "Source media", "pt": "Origem" },
      "input": "select",
      "options": [
        { "id": "native_digital_file", "en": "Native digital file", "pt": "Arquivo digital original" },
        { "id": "memory_card", "en": "Memory card", "pt": "Cartão de memória" },
        { "id": "cd", "en": "CD", "pt": "CD" },
        { "id": "tape", "en": "Tape", "pt": "Fita" },
        { "id": "vinyl", "en": "Vinyl", "pt": "Vinil" },
        { "id": "phone", "en": "Phone", "pt": "Celular" },
        { "id": "other", "en": "Other", "pt": "Outro" }
      ]
    },
    "mediaId": {
      "id": "media_id",
      "label": { "en": "Card, CD or tape ID", "pt": "ID do cartão, CD ou fita" },
      "placeholder": { "en": "Label, number or name written on it", "pt": "Etiqueta, número ou nome escrito nele" },
      "input": "text"
    },
    "context": {
      "id": "context",
      "label": { "en": "Context / Additional Details", "pt": "Contexto / Detalhes adicionais" },
      "input": "text"
    }
  },
  "types": [
    {
      "id": "none",
      "label": { "en": "(none)", "pt": "(nenhum)" },
