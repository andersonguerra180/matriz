        { "id": "cd_label", "label": { "en": "Number or name on the CD", "pt": "Número ou nome escrito no CD" }, "input": "text" },
        { "id": "artist_album", "label": { "en": "Artist and album", "pt": "Artista e álbum" }, "input": "text" },
