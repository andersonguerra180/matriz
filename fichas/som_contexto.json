          "options": [
            { "id": "both", "en": "Both", "pt": "Ambos" },
            { "id": "a", "en": "Side A", "pt": "Lado A" },
            { "id": "b", "en": "Side B", "pt": "Lado B" }
          ]
        },
        {
          "id": "speed",
          "label": { "en": "Speed (RPM)", "pt": "Rotação (RPM)" },
          "input": "select",
          "options": [
            { "id": "33", "en": "33", "pt": "33" },
            { "id": "45", "en": "45", "pt": "45" }
          ]
        },
        {
          "id": "condition",
          "label": { "en": "Record condition", "pt": "Estado do disco" },
          "input": "select",
          "options": [
            { "id": "good", "en": "Good", "pt": "Bom" },
            { "id": "noisy", "en": "Noisy", "pt": "Chiado" },
            { "id": "scratched", "en": "Scratched", "pt": "Riscado" }
          ]
        }
      ]
    },
